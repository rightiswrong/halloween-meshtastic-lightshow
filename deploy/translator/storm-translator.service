[Unit]
Description=Storm translator (porch Meshtastic node -> Home Assistant scripts)
After=network-online.target
Wants=network-online.target

[Service]
User=storm-translator
Group=storm-translator
# Porch T-Beam on USB instead of TCP: install.sh --usb adds a drop-in
# (usb-radio.conf) with SupplementaryGroups=dialout and PrivateDevices=no.
ExecStart=/opt/storm-translator/bin/storm-translator --config /etc/storm/translator.toml
Restart=always
RestartSec=5
TasksMax=64
MemoryMax=192M
StateDirectory=storm-translator
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
